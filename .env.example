# Public Google tag ID (GTM-… container from GA4 "Install manually", or a G-… measurement ID). GitHub Actions reads the same
# value from the NEXT_PUBLIC_GA_ID repository variable at build time.
NEXT_PUBLIC_GA_ID=GTM-P2RD6SJD

# Public HTTPS form endpoint from a trusted external form provider. Leave blank for WhatsApp/email-only inquiries.
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=

# Enable indexing only for an approved production release. Set false for previews.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Optional public ownership-verification tokens.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_MERCHANT_CENTER_VERIFICATION=

# Verified legal/support identity. Leave blank until approved.
NEXT_PUBLIC_LEGAL_BUSINESS_NAME=
NEXT_PUBLIC_SUPPORT_EMAIL=mazharchdev@gmail.com
